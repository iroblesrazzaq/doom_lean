def main : IO UInt32 := do
  let wad ← loadIwad
  let tt ← match initTextures wad with
    | Except.error e => IO.eprintln e; return 1
    | Except.ok t => pure t
  let goldenStartan3 ← goldenStartan3Col0Golden
  let goldenDoor3 ← goldenDoor3Col127Golden
  let mut ok := true
  ok := (← assert "numTextures=125" (tt.numTextures == 125)) && ok
  ok := (← assert "STARTAN3=70" (checkTextureNumForName tt (nameTo8 "STARTAN3") == some 70)) && ok
  ok := (← assert "BROWN1=14" (checkTextureNumForName tt (nameTo8 "BROWN1") == some 14)) && ok
  ok := (← assert "DOOR3=30" (checkTextureNumForName tt (nameTo8 "DOOR3") == some 30)) && ok
  ok := (← assert "dash texture=0" (checkTextureNumForName tt (nameTo8 "-") == some 0)) && ok
  match flatNumFromBytes tt wad (nameTo8 "FLOOR4_8") with
  | Except.error e => IO.eprintln e; ok := false
  | Except.ok n => ok := (← assert "FLOOR4_8 flat=10" (n == 10)) && ok
  match textureNumForName tt (nameTo8 "SKY1") with
  | Except.error e => IO.eprintln e; ok := false
  | Except.ok skyTex =>
    ok := (← assert "skytexture=SKY1" (tt.skytexture == skyTex)) && ok
  match flatNumFromBytes tt wad (nameTo8 "F_SKY1") with
  | Except.error e => IO.eprintln e; ok := false
  | Except.ok n => ok := (← assert "skyFlatNum=F_SKY1" (tt.skyFlatNum == n)) && ok
  let startan3 := checkTextureNumForName tt (nameTo8 "STARTAN3") |>.getD 0
  let (tt1, col0) ← match getColumn tt wad startan3 0 with
    | Except.error e => IO.eprintln e; return 1
    | Except.ok r => pure r
  ok := (← assert "STARTAN3 col0 golden" (bytesEq col0 goldenStartan3)) && ok
  let door3 := checkTextureNumForName tt (nameTo8 "DOOR3") |>.getD 0
  let (_, col127) ← match getColumn tt1 wad door3 127 with
    | Except.error e => IO.eprintln e; return 1
    | Except.ok r => pure r
  ok := (← assert "DOOR3 col127 masked golden" (bytesEq col127 goldenDoor3)) && ok
  let (_, compCol) ← match getColumn syntheticCompositeTables syntheticWad 0 1 with
    | Except.error e => IO.eprintln e; return 1
    | Except.ok r => pure r
  ok := (← assert "synthetic composite col1 golden" (bytesEq compCol goldenCompositeCol1)) && ok
  if ok then IO.println "render-data-test: all passed"; return 0
  else IO.eprintln "render-data-test: failures"; return 1
